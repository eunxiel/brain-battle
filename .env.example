# Server
PORT=4000

# Signs the HMAC player tokens. Optional locally (the server generates one into
# apps/server/.data/session.secret); required in production, where an ephemeral
# disk would otherwise invalidate every player's token on each restart.
SESSION_SECRET=

# Both of the following are ONLY needed when the client is hosted separately
# from the server. After `npm run build` the server serves the client itself,
# so they share an origin and neither setting applies.
#
#   CLIENT_ORIGIN   origin of the separately hosted client, exact, no trailing
#                   slash, e.g. https://your-app.vercel.app
#   VITE_SERVER_URL where that client should look for this server; Vite bakes
#                   it in at build time, so changing it needs a rebuild
CLIENT_ORIGIN=
VITE_SERVER_URL=

# PostgreSQL (optional in development).
# When DATABASE_URL is absent the server falls back to a file-backed store
# in apps/server/.data so the game stays fully playable offline.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brain_battle
