{
  "name": "brain-battle",
  "version": "1.0.0",
  "private": true,
  "description": "BRAIN BATTLE - Think Fast. Play Smart. Win Together.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @brain-battle/server",
    "dev:web": "npm run dev --workspace @brain-battle/web",
    "build": "npm run build --workspace @brain-battle/web",
    "start": "npm run start --workspace @brain-battle/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
